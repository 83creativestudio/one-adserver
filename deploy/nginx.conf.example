# Managed release configuration for the existing ONE Control site.
# Installed at /etc/nginx/conf.d/one-control/adserver.onedigital.com.cy.conf.
server {
    listen 49.13.84.162:80;
    listen [2a01:4f8:c012:82ed::1]:80;
    server_name adserver.onedigital.com.cy www.adserver.onedigital.com.cy;
    location /.well-known/acme-challenge/ {
        root /var/www/one-control-sites/adserver.onedigital.com.cy/public;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 49.13.84.162:443 ssl;
    listen [2a01:4f8:c012:82ed::1]:443 ssl;
    server_name adserver.onedigital.com.cy www.adserver.onedigital.com.cy;
    root /var/www/one-control-sites/adserver.onedigital.com.cy/public;
    ssl_certificate /etc/letsencrypt/live/adserver.onedigital.com.cy/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adserver.onedigital.com.cy/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    # Signed ad tracking URLs carry tokens in their query strings.
    access_log off;
    error_log /var/log/nginx/one-control-adserver.onedigital.com.cy.error.log;
    location = /api/auth/login {
        proxy_pass http://127.0.0.1:3017;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:3017;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
