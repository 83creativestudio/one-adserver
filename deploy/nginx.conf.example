# Include inside nginx's http context. Replace ads.example.com and certificate paths.
limit_req_zone $binary_remote_addr zone=one_login:10m rate=5r/m;
server {
    listen 80;
    server_name ads.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ads.example.com;
    ssl_certificate /etc/letsencrypt/live/ads.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ads.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    # Do not write signed ad query strings to access logs.
    access_log off;
    location = /api/auth/login {
        limit_req zone=one_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
