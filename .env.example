# Local development defaults to SQLite. No database server is required.
DB_PROVIDER=sqlite
DATABASE_PATH=data/one-adserver.sqlite

ADMIN_PASSWORD=replace-with-a-strong-password
DELIVERY_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
UPLOAD_DIR=data/uploads
# Only enable behind a private, trusted reverse proxy overwriting X-Real-IP.
TRUST_PROXY=false
# Docker Compose also requires an independent DB_ROOT_PASSWORD.
# DB_ROOT_PASSWORD=

# Live server: set DB_PROVIDER=mariadb and configure an existing empty database.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=one_adserver
# DB_USER=one_adserver
# DB_PASSWORD=
# DB_POOL_SIZE=10
# DB_SSL=true
# DB_SSL_CA=/absolute/path/to/ca.pem
# DB_SOCKET=/path/to/mariadb.sock
